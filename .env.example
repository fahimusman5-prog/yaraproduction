# Optional public WhatsApp numbers, in international format without + or spaces.
# The storefront uses its existing numbers when these variables are omitted.
NEXT_PUBLIC_WHATSAPP_NUMBER_SRI_LANKA=
NEXT_PUBLIC_WHATSAPP_NUMBER_UAE=

# Optional official Facebook page. Leave blank until a verified YARA page URL is available.
NEXT_PUBLIC_YARA_FACEBOOK_URL=

# Required for admin and POS. Use the publishable key, never the service role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_your_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Legacy alias accepted for existing deployments; set both to https://www.yaraproduct.com in Production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only HMAC secret used to authorize guest order-status lookups.
ORDER_TRACKING_SECRET=replace-with-a-long-random-secret

# Server-only HMAC secret used to pseudonymise durable API rate-limit keys.
RATE_LIMIT_SECRET=replace-with-a-different-long-random-secret

# PayHere merchant credentials. Use sandbox=true until merchant approval is complete.
PAYMENTS_ENABLED=false
PAYHERE_ENABLED=false
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true

# Transactional email (server-only; never prefix the API key with NEXT_PUBLIC_).
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
ADMIN_NOTIFICATION_EMAIL=

# Consent-aware first-party analytics.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_ANALYTICS_DEBUG=false
